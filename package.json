{
  "name": "@inixiative/permissions",
  "version": "0.17.0",
  "description": "Generic rebac/abac/rbac core — a permix wrapper + relationship-walking check engine; the app passes its schema map (a prisma-map map and its polymorphism registry)",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "check": "bun run typecheck && bun run lint && bun run test",
    "bench": "bun bench/check.bench.ts",
    "prepare": "if git rev-parse --git-dir >/dev/null 2>&1; then lefthook install; fi",
    "prepublishOnly": "bun run check && bun run build"
  },
  "keywords": [
    "permissions",
    "authorization",
    "rebac",
    "abac",
    "rbac",
    "permix",
    "json-rules",
    "typescript"
  ],
  "author": "Aron Greenspan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/inixiative/permissions.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.2",
    "@inixiative/config": "^0.5.150",
    "@types/bun": "1.4.4",
    "@types/lodash-es": "^4.17.12",
    "lefthook": "2.1.9",
    "permix": "^3.6.0",
    "tsup": "8.5.1",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "typescript": ">=6.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@inixiative/json-rules": "^3.16.0",
    "lodash-es": "^4.17.21"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "packageManager": "bun@1.4.4"
}
